# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Authentication
JWT_SECRET=generate_a_strong_random_secret_here
JWT_EXPIRE=30d

# Frontend URL (comma-separated for multiple origins)
# Also accepted: CLIENT_URL (takes precedence when both are set)
FRONTEND_URL=http://localhost:3000

# Absolute origin of this API — used to build uploaded-photo URLs in the
# local-disk fallback mode. On Vercel set it to https://<project>.vercel.app
PUBLIC_API_URL=

# Cloudinary (photo uploads) — when all three are set, produce photos are
# uploaded to Cloudinary (memory storage) instead of the local `uploads/`
# directory. Required on Vercel (read-only filesystem).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cron secret for the hourly escrow auto-release
# (GET /api/orders/escrow/cron, scheduled by vercel.json "crons").
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# External Services (optional)
WEATHER_API_KEY=your_weather_api_key
PAYMENT_GATEWAY_KEY=your_payment_gateway_key
AI_API_KEY=your_ai_api_key
CLOUD_STORAGE_BUCKET=your_cloud_storage_bucket

# Stripe (test mode) — https://dashboard.stripe.com/apikeys
# Secret key is read server-side only (never in NEXT_PUBLIC_ variables).
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
